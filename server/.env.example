PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=change-this-admin-password
GROUP_SIZE=8
# Set this to your deployed web app's URL once you have one (e.g. https://osusu.vercel.app)
CORS_ORIGIN=*

# Optional: point at a hosted Turso (libSQL) database for persistent storage.
# If left unset, the server falls back to a local SQLite file (server/osusu.db) -
# fine for local dev, but NOT durable on Render's free plan (see README).
# TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token
